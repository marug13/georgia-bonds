// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String?  // Null for OAuth users
  balance   Float    @default(10000.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isAdmin   Boolean  @default(false)

  positions Position[]
  trades    Trade[]

  @@index([email])
  @@index([username])
}

enum MarketCategory {
  POLITICS    // პოლიტიკა
  SPORTS      // სპორტი
  ECONOMY     // ეკონომიკა
  CULTURE     // კულტურა
  WEATHER     // ამინდი
  ENTERTAINMENT // გართობა
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
}

model Market {
  id              String         @id @default(cuid())
  titleKa         String         // Georgian title
  titleEn         String         // English title
  description     String         @db.Text
  category        MarketCategory
  resolutionDate  DateTime
  status          MarketStatus   @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // AMM liquidity pool
  yesLiquidity    Float          @default(5000.0)
  noLiquidity     Float          @default(5000.0)
  totalVolume     Float          @default(0.0)

  positions       Position[]
  trades          Trade[]
  resolution      Resolution?

  @@index([status])
  @@index([category])
  @@index([resolutionDate])
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  isYes     Boolean  // true for YES, false for NO
  shares    Float
  avgPrice  Float    // Average purchase price
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId, isYes])
  @@index([userId])
  @@index([marketId])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  isYes     Boolean  // true for YES, false for NO
  isBuy     Boolean  // true for buy, false for sell
  shares    Float
  price     Float    // Price per share at time of trade
  total     Float    // Total cost/revenue
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([marketId])
  @@index([timestamp])
}

model Resolution {
  id         String   @id @default(cuid())
  marketId   String   @unique
  outcome    Boolean  // true if YES won, false if NO won
  resolvedAt DateTime @default(now())

  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}
